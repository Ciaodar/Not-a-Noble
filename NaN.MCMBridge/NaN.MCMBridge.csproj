  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />

  <!-- Pre-Build Version Update -->
  <Target Name="UpdateVersion" BeforeTargets="PreBuildEvent">
    <Exec Command="powershell.exe -ExecutionPolicy Bypass -NoProfile -NonInteractive -File &quot;$(ProjectDir)..\NaN\Build\UpdateVersion.ps1&quot; &quot;$(ProjectDir)Properties\AssemblyInfo.cs&quot; &quot;$(Configuration)&quot;" ContinueOnError="false" />
  </Target>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <PropertyGroup>
      <ModuleFolder>$(GameFolder)\Modules\Not-a-Noble</ModuleFolder>
    </PropertyGroup>
    <ItemGroup>
      <ModuleBin Include="$(TargetDir)NaN.MCMBridge.dll" />
    </ItemGroup>
    
    <Copy SourceFiles="@(ModuleBin)" DestinationFolder="$(ModuleFolder)\bin\Win64_Shipping_Client" SkipUnchangedFiles="true" />
    
    <!-- En son derlenen proje MCMBridge olduğu için Desktop'a Zip çıktısını burada alıyoruz -->
    <Exec Command="powershell.exe -ExecutionPolicy Bypass -NoProfile -NonInteractive -Command &quot;$desktop = [Environment]::GetFolderPath('Desktop'); $zipPath = Join-Path $desktop 'Not-a-Noble.zip'; if (Test-Path $zipPath) { Remove-Item $zipPath -Force }; Compress-Archive -Path '$(ModuleFolder)' -DestinationPath $zipPath -Force&quot;" />
  </Target>
</Project>
